{
  "name": "twitch-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19 <25"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "check:structure": "node scripts/check-structure.mjs",
    "dev": "corepack pnpm -r --parallel dev",
    "lint": "eslint . --max-warnings=0",
    "smoke:twitch": "corepack pnpm --filter @twitch-tracker/worker smoke:twitch",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r typecheck"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
