{
  "name": "twitch-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:structure": "node scripts/check-structure.mjs",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint . --max-warnings=0",
    "smoke:twitch": "pnpm --filter @twitch-tracker/worker smoke:twitch",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
