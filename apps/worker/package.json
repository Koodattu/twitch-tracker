{
  "name": "@twitch-tracker/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --conditions=development --import tsx --watch src/index.ts",
    "smoke:twitch": "node --conditions=development --import tsx src/smoke/twitch.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@twitch-tracker/config": "workspace:*",
    "@twitch-tracker/db": "workspace:*",
    "@twitch-tracker/shared": "workspace:*",
    "@twitch-tracker/twitch": "workspace:*",
    "drizzle-orm": "0.45.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
