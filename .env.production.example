PUBLIC_DOMAIN=tracker.example.com
CADDY_EMAIL=operations@example.com

POSTGRES_DB=twitch_tracker
POSTGRES_USER=twitch_tracker
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
DATABASE_URL_FILE=./secrets/database_url
SESSION_SECRET_FILE=./secrets/session_secret
TWITCH_CLIENT_SECRET_FILE=./secrets/twitch_client_secret
TWITCH_EVENTSUB_SECRET_FILE=./secrets/twitch_eventsub_secret

TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_LOGIN_SCOPES=
TWITCH_BOT_SCOPES=chat:read user:read:chat user:read:moderated_channels moderator:read:chatters
ADMIN_TWITCH_USER_IDS=replace-with-twitch-user-id
ADMIN_TWITCH_LOGINS=

EVENTSUB_ENABLED=false
EVENTSUB_MAX_CHANNELS=25
ENABLE_TWITCH_INGESTION=false
DEFAULT_BOT_JOIN_CAPACITY=100
DEFAULT_BOT_JOIN_RATE_PER_10_SECONDS=20
DISCOVERY_INTERVAL_MS=180000
USER_HYDRATION_INTERVAL_MS=300000
ASSIGNMENT_INTERVAL_MS=30000
CHATTERS_RECONCILIATION_INTERVAL_MS=300000
CHATTERS_RECONCILIATION_MAX_CHANNELS=25
CHATTERS_RECONCILIATION_MAX_PAGES_PER_CHANNEL=5
AGGREGATION_INTERVAL_MS=60000
AGGREGATION_BUCKET_MINUTES=5
AGGREGATION_LOOKBACK_HOURS=48
MAINTENANCE_INTERVAL_MS=300000
RAW_CHAT_RETENTION_DAYS=30
RAW_PAYLOAD_RETENTION_DAYS=30
STALE_ASSIGNMENT_GRACE_MINUTES=15
SESSION_TTL_DAYS=30
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
WORKER_NAME=worker-1
WORKER_HEALTH_MAX_AGE_MS=900000

# This must be an off-host or separately replicated mount owned by uid/gid 70 for the Alpine backup container.
BACKUP_HOST_PATH=/mnt/offsite-backups/twitch-tracker

IMAGE_TAG=replace-with-release-id
VCS_REF=replace-with-git-commit
